-- BUSINESS USE CASE:
-- This query combines order items with product and inventory data to provide a real-time view of order fulfillment status. It is used to:
-- Track inventory availability for each order item
-- Identify backorders or low-stock situations
-- Help fulfillment teams prioritize shipping based on stock status

-- REAL-WORLD SCENARIO:
-- During peak sales, operations uses this query to spot which order items are at risk due to stock shortages and reroute inventory from other warehouses if needed.

-- Impact:
-- Prevents shipment delays, reduces customer complaints, and ensures efficient inventory utilization across active orders.


USE urbanease_shop;

-- TODO: Write your complex query here
-- Example: Get Order Items with Product & Inventory Details

SELECT 
  oi.order_id,
  pv.sku,
  pv.price AS unit_price,
  oi.qty AS qty_ordered,
  (oi.qty * pv.price) AS line_total,
  i.on_hand,
  i.reserved,
  (i.on_hand - i.reserved) AS available_stock
FROM OrderItems oi
JOIN Orders o ON oi.order_id = o.order_id                   -- Get order context
JOIN ProductVariants pv ON oi.variant_id = pv.variant_id    -- Get SKU details
LEFT JOIN Inventory i ON pv.variant_id = i.variant_id       -- Inventory info (may be null)
WHERE o.status = 'PAID'
ORDER BY o.placed_at DESC
LIMIT 10;
